{
  "name": "Adhan Home",
  "short_name": "Adhan Home",
  "description": "Prayer times, the adhan for your whole home, the Quran with 24 sheikhs, and Arabic for kids and grown-ups.",
  "id": "/adhan-home-app/",
  "start_url": "/adhan-home-app/",
  "scope": "/adhan-home-app/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#06101F",
  "theme_color": "#0F5C4D",
  "categories": [
    "lifestyle",
    "education",
    "books"
  ],
  "icons": [
    {
      "src": "/adhan-home-app/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/adhan-home-app/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/adhan-home-app/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Quran",
      "url": "/adhan-home-app/quran",
      "icons": [
        {
          "src": "/adhan-home-app/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Arabic path",
      "url": "/adhan-home-app/course",
      "icons": [
        {
          "src": "/adhan-home-app/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My masjid",
      "url": "/adhan-home-app/masjid",
      "icons": [
        {
          "src": "/adhan-home-app/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}